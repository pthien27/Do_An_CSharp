<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:maps="http://schemas.microsoft.com/dotnet/2021/maui/maps"
             x:Class="VinhKhanhstreet.Pages.MapPage"
             Shell.NavBarIsVisible="False">
    <ContentPage.Resources>
        <DataTemplate x:Key="PoiTemplate">
            <Frame Margin="0,0,0,15" Padding="15" CornerRadius="12" HasShadow="True" BorderColor="{AppThemeBinding Light=#EEEEEE, Dark=#333333}" BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}">
                <VerticalStackLayout Spacing="8">
                    <!-- Title -->
                    <Label Text="{Binding CurrentDisplayName}" FontAttributes="Bold" FontSize="18" TextColor="{AppThemeBinding Light=Black, Dark=White}"/>
                    
                    <!-- Category & Distance -->
                    <HorizontalStackLayout Spacing="5" VerticalOptions="Center">
                        <Label Text="{Binding StrCategoryAndDistance}" TextColor="{AppThemeBinding Light=Gray, Dark=#AAAAAA}" FontSize="13" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                    
                    <!-- Status & Closing Time -->
                    <HorizontalStackLayout Spacing="5" VerticalOptions="Center">
                        <Label Text="{Binding StrStatusOpen}" TextColor="{Binding StatusTextColor}" FontAttributes="Bold" FontSize="13"/>
                        <Label Text="·" TextColor="{AppThemeBinding Light=Gray, Dark=#AAAAAA}" FontSize="13" FontAttributes="Bold"/>
                        <Label Text="{Binding StrClosingTime}" TextColor="{AppThemeBinding Light=Gray, Dark=#AAAAAA}" FontSize="13"/>
                    </HorizontalStackLayout>

                    <!-- Image Placeholder (ScrollView Horizontal) -->
                    <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never" Margin="0,5,0,5" HeightRequest="150">
                        <HorizontalStackLayout Spacing="10">
                            <!-- Ảnh 1 -->
                            <Frame CornerRadius="12" HasShadow="False" Padding="0" IsClippedToBounds="True" WidthRequest="150" HeightRequest="150" BorderColor="Transparent" BackgroundColor="#E0E0E0">
                                <Image Source="{Binding ImageUrl1}" Aspect="AspectFill" />
                            </Frame>
                            <!-- Ảnh 2 -->
                            <Frame CornerRadius="12" HasShadow="False" Padding="0" IsClippedToBounds="True" WidthRequest="150" HeightRequest="150" BorderColor="Transparent" BackgroundColor="#EEEEEE">
                                <Image Source="{Binding ImageUrl2}" Aspect="AspectFill" />
                            </Frame>
                            <!-- Ảnh 3 -->
                            <Frame CornerRadius="12" HasShadow="False" Padding="0" IsClippedToBounds="True" WidthRequest="150" HeightRequest="150" BorderColor="Transparent" BackgroundColor="#F5F5F5">
                                <Image Source="{Binding ImageUrl3}" Aspect="AspectFill" />
                            </Frame>
                            <!-- Ảnh 4 -->
                            <Frame CornerRadius="12" HasShadow="False" Padding="0" IsClippedToBounds="True" WidthRequest="150" HeightRequest="150" BorderColor="Transparent" BackgroundColor="#E0E0E0">
                                <Image Source="{Binding ImageUrl4}" Aspect="AspectFill" />
                            </Frame>
                            <!-- Ảnh 5 -->
                            <Frame CornerRadius="12" HasShadow="False" Padding="0" IsClippedToBounds="True" WidthRequest="150" HeightRequest="150" BorderColor="Transparent" BackgroundColor="#EEEEEE">
                                <Image Source="{Binding ImageUrl5}" Aspect="AspectFill" />
                            </Frame>
                        </HorizontalStackLayout>
                    </ScrollView>

                    <!-- Buttons (Phát, Gọi, Lưu) -->
                    <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never" HeightRequest="50" Margin="0,0,0,5">
                        <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                            <!-- Nút Phát -->
                            <Button Text="{Binding StrPlay}" CommandParameter="{Binding .}" Clicked="OnCardPlayClicked" 
                                    BackgroundColor="{Binding PlayBgColor}" TextColor="{Binding PlayTextColor}" Padding="20,0" HeightRequest="36" CornerRadius="18" FontSize="13" FontAttributes="Bold"/>
                            
                            <!-- Nút Gọi -->
                            <Button Text="{Binding StrCall}" CommandParameter="{Binding .}" Clicked="OnCardCallClicked" 
                                    BackgroundColor="#E3F2FD" TextColor="#0D47A1" Padding="20,0" HeightRequest="36" CornerRadius="18" FontSize="13" FontAttributes="Bold"/>
                            
                            <!-- Nút Lưu -->
                            <Button Text="{Binding StrSave}" CommandParameter="{Binding .}" Clicked="OnCardSaveClicked" 
                                    BackgroundColor="{Binding SaveBgColor}" TextColor="{Binding SaveTextColor}" Padding="20,0" HeightRequest="36" CornerRadius="18" FontSize="13" FontAttributes="Bold"/>
                        </HorizontalStackLayout>
                    </ScrollView>
                </VerticalStackLayout>
            </Frame>
        </DataTemplate>
    </ContentPage.Resources>

    <Grid>
        <maps:Map x:Name="mapVinhKhanh" IsShowingUser="True" MapClicked="OnMapClicked" />

        <!-- Ô Tìm Kiếm - Nằm cố định góc trái trên cùng -->
        <Frame BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}" 
               CornerRadius="25" 
               HasShadow="True" 
               Padding="5,0"
               HeightRequest="45"
               WidthRequest="220"
               BorderColor="{AppThemeBinding Light=#EEEEEE, Dark=#333333}"
               VerticalOptions="Start" HorizontalOptions="Start" 
               Margin="15,50,0,0">
            <SearchBar x:Name="searchBar" 
                       Placeholder="Tìm quán ăn..." 
                       TextChanged="OnSearchBarTextChanged" 
                       SearchButtonPressed="OnSearchButtonPressed"
                       Focused="OnSearchBarFocused"
                       Unfocused="OnSearchBarUnfocused"
                       CancelButtonColor="Gray" 
                       BackgroundColor="Transparent"
                       TextColor="{AppThemeBinding Light=Black, Dark=White}"
                       PlaceholderColor="{AppThemeBinding Light=Gray, Dark=#AAAAAA}"
                       VerticalOptions="Center" />
        </Frame>

        <!-- Nút Về Vị Trí Hiện Tại & Refresh - Nằm cạnh Thanh tìm kiếm -->
        <HorizontalStackLayout VerticalOptions="Start" HorizontalOptions="End" 
                               Spacing="10"
                               Margin="0,50,15,0">
            <!-- Nút Refresh -->
            <Frame BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}" 
                   CornerRadius="22.5" 
                   HasShadow="True" 
                   Padding="0"
                   HeightRequest="45"
                   WidthRequest="45"
                   BorderColor="{AppThemeBinding Light=#EEEEEE, Dark=#333333}">
                <Frame.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnRefreshTapped" />
                </Frame.GestureRecognizers>
                <Label Text="🔄" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center" />
            </Frame>

            <!-- Nút Vị trí -->
            <Frame BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}" 
                   CornerRadius="22.5" 
                   HasShadow="True" 
                   Padding="0"
                   HeightRequest="45"
                   WidthRequest="45"
                   BorderColor="{AppThemeBinding Light=#EEEEEE, Dark=#333333}">
                <Frame.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnMyLocationTapped" />
                </Frame.GestureRecognizers>
                <Label Text="🎯" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center" />
            </Frame>
        </HorizontalStackLayout>

        <VerticalStackLayout VerticalOptions="End" BackgroundColor="Transparent" Spacing="0">

            <Frame BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}" HasShadow="False" BorderColor="{AppThemeBinding Light=#EEEEEE, Dark=#333333}" Padding="15" CornerRadius="0">
                <Grid ColumnDefinitions="*,*,*">
                    <!-- Tab Quán ăn -->
                    <VerticalStackLayout Grid.Column="0" Spacing="5" HorizontalOptions="Center">
                        <VerticalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnShowRestaurantListTapped" />
                        </VerticalStackLayout.GestureRecognizers>
                        <Label x:Name="lblIconQuanAn" Text="🍴" FontSize="24" HorizontalOptions="Center"/>
                        <Label x:Name="lblTabQuanAn" Text="Quán ăn" FontSize="11" HorizontalOptions="Center" TextColor="{AppThemeBinding Light=Gray, Dark=#AAAAAA}"/>
                    </VerticalStackLayout>

                    <!-- Tab Yêu thích -->
                    <VerticalStackLayout Grid.Column="1" Spacing="5" HorizontalOptions="Center">
                        <VerticalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnShowFavoritesTapped" />
                        </VerticalStackLayout.GestureRecognizers>
                        <Label x:Name="lblIconYeuThich" Text="⭐" FontSize="24" HorizontalOptions="Center"/>
                        <Label x:Name="lblTabYeuThich" Text="Yêu thích" FontSize="11" HorizontalOptions="Center" TextColor="{AppThemeBinding Light=Gray, Dark=#AAAAAA}"/>
                    </VerticalStackLayout>
                    
                    <!-- Tab Xem thêm -->
                    <VerticalStackLayout Grid.Column="2" Spacing="5" HorizontalOptions="Center">
                        <VerticalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnXemThemTapped" />
                        </VerticalStackLayout.GestureRecognizers>
                        <Label x:Name="lblIconXemThem" Text="☰" FontSize="24" HorizontalOptions="Center"/>
                        <Label x:Name="lblTabXemThem" Text="Xem thêm" FontSize="11" HorizontalOptions="Center" TextColor="{AppThemeBinding Light=Gray, Dark=#AAAAAA}"/>
                    </VerticalStackLayout>
                </Grid>
            </Frame>

            <Frame x:Name="frmDanhSach" 
                   IsVisible="False" 
                   BackgroundColor="{AppThemeBinding Light=#F8F9FA, Dark=#121212}" 
                   CornerRadius="0" 
                   Padding="15" 
                   HeightRequest="280"
                   BorderColor="Transparent">
                <Grid RowDefinitions="Auto, Auto, *">
                    <Grid Grid.Row="0" Margin="0,0,0,10" ColumnDefinitions="*, Auto">
                        <!-- Tiêu đề Danh sách -->
                        <Label Grid.Column="0" x:Name="lblListTitle" Text="QUÁN ĂN TRÊN PHỐ VĨNH KHÁNH" FontSize="12" FontAttributes="Bold" TextColor="#2ECC71" VerticalOptions="Center"/>
                        
                        <!-- Nút Khôi Phục / Đóng Danh Sách -->
                        <Label Grid.Column="1" x:Name="lblCloseList" Text="✕" FontSize="18" FontAttributes="Bold" TextColor="{AppThemeBinding Light=Gray, Dark=#AAAAAA}" VerticalOptions="Center" Margin="10,0,0,0">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCloseListOrClearFilterTapped" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>

                    <!-- NÚT GẦN ĐÂY NẰM CHÍNH XÁC DƯỚI TIÊU ĐỀ THEO YÊU CẦU -->
                    <Button Grid.Row="1" x:Name="btnGanDayInsideList" 
                            Text="📍 TÌM QUÁN GẦN ĐÂY" 
                            BackgroundColor="#27AE60" 
                            TextColor="White" 
                            CornerRadius="8" 
                            HeightRequest="35" 
                            Padding="5,0"
                            Margin="0,0,0,10"
                            FontAttributes="Bold"
                            FontSize="12"
                            Clicked="OnAutoNarrateNearbyClicked"/>

                    <Grid Grid.Row="2">
                        <!-- Danh sách chính (Tất cả quán) -->
                        <CollectionView x:Name="lstAll" ZIndex="1" ItemsSource="{Binding .}" SelectionMode="Single" SelectionChanged="OnRestaurantSelected" ItemTemplate="{StaticResource PoiTemplate}" />
                        
                        <!-- Danh sách Yêu thích -->
                        <CollectionView x:Name="lstFav" Opacity="0" InputTransparent="True" ZIndex="0" SelectionMode="Single" SelectionChanged="OnRestaurantSelected" ItemTemplate="{StaticResource PoiTemplate}" />
                        
                        <!-- Danh sách Tập trung (Tìm kiếm/Thuyết minh/Focus) -->
                        <CollectionView x:Name="lstFocus" Opacity="0" InputTransparent="True" ZIndex="0" SelectionMode="Single" SelectionChanged="OnRestaurantSelected" ItemTemplate="{StaticResource PoiTemplate}" />
                    </Grid>
                </Grid>
            </Frame>
        </VerticalStackLayout>

        <!-- OVERLAY NỀN ĐEN BÓNG MỜ -->
        <BoxView x:Name="bgOverlay" 
                 Color="Black" 
                 Opacity="0" 
                 IsVisible="False" 
                 InputTransparent="False">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnCloseSettingsTapped" />
            </BoxView.GestureRecognizers>
        </BoxView>

        <!-- FORM CÀI ĐẶT TỪ PHẢI QUA -->
        <Frame x:Name="frmSettings" 
               BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}" 
               WidthRequest="280" 
               HorizontalOptions="End" 
               VerticalOptions="Fill" 
               TranslationX="280" 
               CornerRadius="0"
               HasShadow="True"
               Padding="20">
            <!-- Loại bỏ Margin để dán sát mép màn hình -->
            <VerticalStackLayout Spacing="25" Margin="0,40,0,0">
                <Grid ColumnDefinitions="*, Auto">
                    <Label x:Name="lblSettingsTitle" Text="Cài đặt" FontSize="18" FontAttributes="Bold" TextColor="{AppThemeBinding Light=Black, Dark=White}" VerticalOptions="Center" Grid.Column="0"/>
                    
                    <HorizontalStackLayout Grid.Column="1" VerticalOptions="Center">
                        <Frame BackgroundColor="#FFEDED" 
                               BorderColor="#FF6B6B" 
                               CornerRadius="8" 
                               Padding="10,4"
                               HasShadow="False">
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnLogoutTapped" />
                            </Frame.GestureRecognizers>
                            <Label x:Name="lblLogout"
                                   Text="Đăng xuất" 
                                   FontSize="11" 
                                   FontAttributes="Bold" 
                                   TextColor="#FF6B6B" 
                                   VerticalOptions="Center"/>
                        </Frame>
                    </HorizontalStackLayout>
                </Grid>
                
                <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#EEEEEE, Dark=#333333}" />

                <!-- CHẾ ĐỘ NỀN -->
                <Grid ColumnDefinitions="*, Auto">
                    <Label x:Name="lblSettingsTheme" Text="Giao diện tối (Dark mode)" FontAttributes="Bold" TextColor="{AppThemeBinding Light=Black, Dark=White}" VerticalOptions="Center"/>
                    <Switch x:Name="swDarkMode" IsToggled="False" Toggled="OnDarkModeToggled" OnColor="#2ECC71" Grid.Column="1"/>
                </Grid>

                <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#EEEEEE, Dark=#333333}" />

                <!-- NGÔN NGỮ -->
                <Label x:Name="lblSettingsLang" Text="Chọn ngôn ngữ" FontAttributes="Bold" TextColor="{AppThemeBinding Light=Black, Dark=White}"/>
                <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="10">
                    <Button x:Name="btnMenuVi" Text="VN" Grid.Column="0" Clicked="OnLanguageViTapped" BackgroundColor="#2ECC71" TextColor="White" Padding="0" HeightRequest="40" CornerRadius="8"/>
                    <Button x:Name="btnMenuEn" Text="EN" Grid.Column="1" Clicked="OnLanguageEnTapped" BackgroundColor="{AppThemeBinding Light=#F0F0F0, Dark=#333333}" TextColor="{AppThemeBinding Light=Gray, Dark=#AAAAAA}" Padding="0" HeightRequest="40" CornerRadius="8"/>
                    <Button x:Name="btnMenuJa" Text="JA" Grid.Column="2" Clicked="OnLanguageJaTapped" BackgroundColor="{AppThemeBinding Light=#F0F0F0, Dark=#333333}" TextColor="{AppThemeBinding Light=Gray, Dark=#AAAAAA}" Padding="0" HeightRequest="40" CornerRadius="8"/>
                    <Button x:Name="btnMenuZh" Text="ZH" Grid.Column="3" Clicked="OnLanguageZhTapped" BackgroundColor="{AppThemeBinding Light=#F0F0F0, Dark=#333333}" TextColor="{AppThemeBinding Light=Gray, Dark=#AAAAAA}" Padding="0" HeightRequest="40" CornerRadius="8"/>
                </Grid>

                <!-- CAO ĐỘ NÓI -->
                <Label x:Name="lblSettingsPitch" Text="Độ vang giọng: 1.0" FontAttributes="Bold" Margin="0,15,0,0" TextColor="{AppThemeBinding Light=Black, Dark=White}"/>
                <Slider x:Name="sliderPitch" Minimum="0.1" Maximum="2.0" Value="1.0" ValueChanged="OnPitchValueChanged" MinimumTrackColor="#2ECC71" MaximumTrackColor="{AppThemeBinding Light=#EEEEEE, Dark=#333333}" ThumbColor="#2ECC71" />
                <Grid ColumnDefinitions="Auto, *, Auto">
                    <Label x:Name="lblPitchLow" Text="Trầm" FontSize="11" TextColor="{AppThemeBinding Light=Gray, Dark=#AAAAAA}" Grid.Column="0"/>
                    <Label x:Name="lblPitchHigh" Text="Thanh" FontSize="11" TextColor="{AppThemeBinding Light=Gray, Dark=#AAAAAA}" Grid.Column="2" HorizontalOptions="End"/>
                </Grid>
                
                <!-- ÂM LƯỢNG NÓI -->
                <Label x:Name="lblSettingsVolume" Text="Âm lượng: 100%" FontAttributes="Bold" Margin="0,15,0,0" TextColor="{AppThemeBinding Light=Black, Dark=White}"/>
                <Slider x:Name="sliderVolume" Minimum="0.0" Maximum="1.0" Value="1.0" ValueChanged="OnVolumeValueChanged" MinimumTrackColor="#2ECC71" MaximumTrackColor="{AppThemeBinding Light=#EEEEEE, Dark=#333333}" ThumbColor="#2ECC71" />
                <Grid ColumnDefinitions="Auto, *, Auto">
                    <Label x:Name="lblVolumeLow" Text="Nhỏ" FontSize="11" TextColor="{AppThemeBinding Light=Gray, Dark=#AAAAAA}" Grid.Column="0"/>
                    <Label x:Name="lblVolumeHigh" Text="To" FontSize="11" TextColor="{AppThemeBinding Light=Gray, Dark=#AAAAAA}" Grid.Column="2" HorizontalOptions="End"/>
                </Grid>
                
                <!-- NÚT LƯU CÀI ĐẶT -->
                <Button x:Name="btnSaveSettings" 
                        Text="LƯU CÀI ĐẶT" 
                        BackgroundColor="#2ECC71" 
                        TextColor="White" 
                        FontAttributes="Bold" 
                        HeightRequest="45" 
                        CornerRadius="10" 
                        Margin="0,15,0,0"
                        Clicked="OnSaveSettingsClicked" />
            </VerticalStackLayout>
        </Frame>

    </Grid>
</ContentPage>