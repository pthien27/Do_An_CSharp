<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:maps="http://schemas.microsoft.com/dotnet/2021/maui/maps"
             x:Class="VinhKhanhstreet.Pages.MapPage"
             Shell.NavBarIsVisible="False">
    <Grid>
        <maps:Map x:Name="mapVinhKhanh" IsShowingUser="True" />

        <VerticalStackLayout VerticalOptions="Start" HorizontalOptions="End" 
                             Margin="0,50,20,0">
            <Frame BackgroundColor="White" 
                   CornerRadius="25" 
                   HasShadow="True" 
                   Padding="12,5"
                   HeightRequest="45"
                   BorderColor="#EEEEEE">
                <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                    <Label x:Name="lblVi" Text="VN" FontSize="15" FontAttributes="Bold" TextColor="#2ECC71">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnLanguageViTapped" />
                        </Label.GestureRecognizers>
                    </Label>

                    <BoxView WidthRequest="1" HeightRequest="15" Color="LightGray" />

                    <Label x:Name="lblEn" Text="EN" FontSize="15" TextColor="Gray">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnLanguageEnTapped" />
                        </Label.GestureRecognizers>
                    </Label>
                    
                    <BoxView WidthRequest="1" HeightRequest="15" Color="LightGray" />

                    <Label x:Name="lblJa" Text="JA" FontSize="15" TextColor="Gray">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnLanguageJaTapped" />
                        </Label.GestureRecognizers>
                    </Label>
                    
                    <BoxView WidthRequest="1" HeightRequest="15" Color="LightGray" />

                    <Label x:Name="lblZh" Text="ZH" FontSize="15" TextColor="Gray">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnLanguageZhTapped" />
                        </Label.GestureRecognizers>
                    </Label>
                </HorizontalStackLayout>
            </Frame>
        </VerticalStackLayout>

        <VerticalStackLayout VerticalOptions="End" BackgroundColor="Transparent" Spacing="0">

            <Frame BackgroundColor="White" CornerRadius="20" HasShadow="True" Padding="15,10" Margin="10,0,10,10">
                <VerticalStackLayout Spacing="2">
                    <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                        <Ellipse x:Name="statusDot" WidthRequest="10" HeightRequest="10" Fill="Red" VerticalOptions="Center"/>
                        <Label x:Name="lblStatus" Text="Hệ thống đã sẵn sàng" FontAttributes="Bold" VerticalOptions="Center" TextColor="Black"/>
                    </HorizontalStackLayout>
                    <Label x:Name="lblCoords" Text="Nhấn vào ghim trên bản đồ để nghe thuyết minh" FontSize="10" HorizontalOptions="Center" TextColor="Gray"/>
                </VerticalStackLayout>
            </Frame>

            <Frame BackgroundColor="White" HasShadow="False" BorderColor="#EEEEEE" Padding="15" CornerRadius="0">
                <Grid ColumnDefinitions="*,*,*,*">
                    <VerticalStackLayout Grid.Column="0" Spacing="5" HorizontalOptions="Center">
                        <VerticalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnShowRestaurantListTapped" />
                        </VerticalStackLayout.GestureRecognizers>
                        <Label Text="🍴" FontSize="24" HorizontalOptions="Center"/>
                        <Label x:Name="lblTabQuanAn" Text="Quán ăn" FontSize="11" HorizontalOptions="Center" TextColor="Gray"/>
                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Column="1" Spacing="5" HorizontalOptions="Center">
                        <VerticalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnShowFavoritesTapped" />
                        </VerticalStackLayout.GestureRecognizers>
                        <Label Text="⭐" FontSize="24" HorizontalOptions="Center"/>
                        <Label x:Name="lblTabYeuThich" Text="Yêu thích" FontSize="11" HorizontalOptions="Center" TextColor="Gray"/>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="2" Spacing="5" HorizontalOptions="Center">
                        <Label Text="🕒" FontSize="24" HorizontalOptions="Center"/>
                        <Label x:Name="lblTabLichSu" Text="Lịch sử" FontSize="11" HorizontalOptions="Center" TextColor="Gray"/>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="3" Spacing="5" HorizontalOptions="Center">
                        <VerticalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnXemThemTapped" />
                        </VerticalStackLayout.GestureRecognizers>
                        <Label Text="☰" FontSize="24" HorizontalOptions="Center"/>
                        <Label x:Name="lblTabXemThem" Text="Xem thêm" FontSize="11" HorizontalOptions="Center" TextColor="Gray"/>
                    </VerticalStackLayout>
                </Grid>
            </Frame>

            <Frame x:Name="frmDanhSach" 
                   IsVisible="False" 
                   BackgroundColor="#F8F9FA" 
                   CornerRadius="0" 
                   Padding="15" 
                   HeightRequest="280"
                   BorderColor="Transparent">
                <Grid RowDefinitions="Auto, *">
                    <Label Grid.Row="0" x:Name="lblListTitle" Text="QUÁN ĂN TRÊN PHỐ VĨNH KHÁNH" FontSize="12" FontAttributes="Bold" TextColor="#2ECC71" Margin="0,0,0,10"/>

                    <CollectionView Grid.Row="1" 
                                    x:Name="lstQuánFull"
                                    SelectionMode="Single"
                                    SelectionChanged="OnRestaurantSelected">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Frame Margin="0,0,0,15" Padding="15" CornerRadius="12" HasShadow="True" BorderColor="#EEEEEE" BackgroundColor="White">
                                    <VerticalStackLayout Spacing="8">
                                        <!-- Title -->
                                        <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="18" TextColor="Black"/>
                                        
                                        <!-- Rating, Reviews, Category -->
                                        <HorizontalStackLayout Spacing="5" VerticalOptions="Center">
                                            <Label Text="{Binding Rating, StringFormat='{0:F1}'}" FontAttributes="Bold" TextColor="Black" FontSize="13"/>
                                            <Label Text="★" TextColor="#FFC107" FontSize="13" FontAttributes="Bold" VerticalOptions="Center"/>
                                            <Label Text="{Binding ReviewCount, StringFormat='({0})'}" TextColor="Gray" FontSize="13" VerticalOptions="Center"/>
                                            <Label Text="·" TextColor="Gray" FontSize="13" VerticalOptions="Center"/>
                                            <Label Text="{Binding StrCategoryAndDistance}" TextColor="Gray" FontSize="13" VerticalOptions="Center"/>
                                        </HorizontalStackLayout>
                                        
                                        <!-- Status & Closing Time -->
                                        <HorizontalStackLayout Spacing="5" VerticalOptions="Center">
                                            <Label Text="{Binding StrStatusOpen}" TextColor="#2E7D32" FontAttributes="Bold" FontSize="13"/>
                                            <Label Text="·" TextColor="Gray" FontSize="13" FontAttributes="Bold"/>
                                            <Label Text="{Binding StrClosingTime}" TextColor="Gray" FontSize="13"/>
                                        </HorizontalStackLayout>

                                        <!-- Image Placeholder (ScrollView Horizontal) -->
                                        <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never" Margin="0,5,0,5" HeightRequest="150">
                                            <HorizontalStackLayout Spacing="10">
                                                <!-- Frame bo góc cho ảnh 1 -->
                                                <Frame CornerRadius="12" HasShadow="False" Padding="0" IsClippedToBounds="True" WidthRequest="150" HeightRequest="150" BorderColor="Transparent" BackgroundColor="#E0E0E0">
                                                    <Image Source="{Binding ImageUrl}" Aspect="AspectFill" />
                                                </Frame>
                                                <!-- BoxView placeholder cho ảnh 2 -->
                                                <BoxView WidthRequest="150" HeightRequest="150" Color="#EEEEEE" CornerRadius="12"/>
                                                <!-- BoxView placeholder cho ảnh 3 -->
                                                <BoxView WidthRequest="150" HeightRequest="150" Color="#F5F5F5" CornerRadius="12"/>
                                            </HorizontalStackLayout>
                                        </ScrollView>

                                        <!-- Description -->
                                        <Label Text="{Binding CurrentDisplayDescription}" FontSize="13" TextColor="#555555" LineBreakMode="WordWrap" MaxLines="2" Margin="0,0,0,5"/>

                                        <!-- Buttons (Phát, Gọi, Lưu) -->
                                        <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never" HeightRequest="50" Margin="0,0,0,5">
                                            <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                                                <!-- Nút Phát -->
                                                <Button Text="{Binding StrPlay}" CommandParameter="{Binding .}" Clicked="OnCardPlayClicked" 
                                                        BackgroundColor="#E3F2FD" TextColor="#0D47A1" Padding="20,0" HeightRequest="36" CornerRadius="18" FontSize="13" FontAttributes="Bold"/>
                                                
                                                <!-- Nút Gọi -->
                                                <Button Text="{Binding StrCall}" CommandParameter="{Binding .}" Clicked="OnCardCallClicked" 
                                                        BackgroundColor="#E3F2FD" TextColor="#0D47A1" Padding="20,0" HeightRequest="36" CornerRadius="18" FontSize="13" FontAttributes="Bold"/>
                                                
                                                <!-- Nút Lưu -->
                                                <Button Text="{Binding StrSave}" CommandParameter="{Binding .}" Clicked="OnCardSaveClicked" 
                                                        BackgroundColor="{Binding SaveBgColor}" TextColor="{Binding SaveTextColor}" Padding="20,0" HeightRequest="36" CornerRadius="18" FontSize="13" FontAttributes="Bold"/>
                                            </HorizontalStackLayout>
                                        </ScrollView>
                                    </VerticalStackLayout>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Grid>
            </Frame>
        </VerticalStackLayout>

        <!-- OVERLAY NỀN ĐEN BÓNG MỜ -->
        <BoxView x:Name="bgOverlay" 
                 Color="Black" 
                 Opacity="0" 
                 IsVisible="False" 
                 InputTransparent="False">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnCloseSettingsTapped" />
            </BoxView.GestureRecognizers>
        </BoxView>

        <!-- FORM CÀI ĐẶT TỪ PHẢI QUA -->
        <Frame x:Name="frmSettings" 
               BackgroundColor="White" 
               WidthRequest="280" 
               HorizontalOptions="End" 
               VerticalOptions="Fill" 
               TranslationX="280" 
               CornerRadius="0"
               HasShadow="True"
               Padding="20">
            <!-- Loại bỏ Margin để dán sát mép màn hình -->
            <VerticalStackLayout Spacing="25" Margin="0,40,0,0">
                <Grid ColumnDefinitions="*, Auto">
                    <Label x:Name="lblSettingsTitle" Text="Cài đặt" FontSize="22" FontAttributes="Bold" TextColor="Black" VerticalOptions="Center" Grid.Column="0"/>
                    <Label Text="✕" FontSize="20" FontAttributes="Bold" TextColor="Gray" VerticalOptions="Center" Grid.Column="1">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCloseSettingsTapped" />
                        </Label.GestureRecognizers>
                    </Label>
                </Grid>
                
                <BoxView HeightRequest="1" Color="#EEEEEE" />

                <!-- NGÔN NGỮ -->
                <Label x:Name="lblSettingsLang" Text="Chọn ngôn ngữ" FontAttributes="Bold" TextColor="Black"/>
                <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="10">
                    <Button x:Name="btnMenuVi" Text="VN" Grid.Column="0" Clicked="OnLanguageViTapped" BackgroundColor="#2ECC71" TextColor="White" Padding="0" HeightRequest="40" CornerRadius="8"/>
                    <Button x:Name="btnMenuEn" Text="EN" Grid.Column="1" Clicked="OnLanguageEnTapped" BackgroundColor="#F0F0F0" TextColor="Gray" Padding="0" HeightRequest="40" CornerRadius="8"/>
                    <Button x:Name="btnMenuJa" Text="JA" Grid.Column="2" Clicked="OnLanguageJaTapped" BackgroundColor="#F0F0F0" TextColor="Gray" Padding="0" HeightRequest="40" CornerRadius="8"/>
                    <Button x:Name="btnMenuZh" Text="ZH" Grid.Column="3" Clicked="OnLanguageZhTapped" BackgroundColor="#F0F0F0" TextColor="Gray" Padding="0" HeightRequest="40" CornerRadius="8"/>
                </Grid>

                <!-- CAO ĐỘ NÓI -->
                <!-- MAUI TextToSpeech mặc định không support Tốc Độ (Speed), chỉ hỗ trợ Độ Vang (Pitch) -->
                <Label x:Name="lblSettingsPitch" Text="Độ vang giọng: 1.0" FontAttributes="Bold" Margin="0,15,0,0" TextColor="Black"/>
                <Slider x:Name="sliderPitch" Minimum="0.1" Maximum="2.0" Value="1.0" ValueChanged="OnPitchValueChanged" MinimumTrackColor="#2ECC71" MaximumTrackColor="#EEEEEE" ThumbColor="#2ECC71" />
                <Grid ColumnDefinitions="Auto, *, Auto">
                    <Label x:Name="lblPitchLow" Text="Trầm" FontSize="11" TextColor="Gray" Grid.Column="0"/>
                    <Label x:Name="lblPitchHigh" Text="Thanh" FontSize="11" TextColor="Gray" Grid.Column="2" HorizontalOptions="End"/>
                </Grid>
            </VerticalStackLayout>
        </Frame>

    </Grid>
</ContentPage>