<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="VinhKhanhstreet.Pages.UserLoginPage"
             NavigationPage.HasNavigationBar="False">

    <Grid>
        <!-- Background Gradient -->
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0f172a" Offset="0.1" />
                <GradientStop Color="#1e293b" Offset="1.0" />
            </LinearGradientBrush>
        </Grid.Background>

        <ScrollView VerticalOptions="Center">
            <VerticalStackLayout Spacing="30" Padding="40" MaximumWidthRequest="500">
                
                <!-- Logo/Icon Area -->
                <VerticalStackLayout HorizontalOptions="Center" Spacing="10">
                    <Frame BackgroundColor="#10b981" 
                           HeightRequest="80" WidthRequest="80" 
                           CornerRadius="20" HasShadow="False"
                           Padding="0">
                        <Label Text="👤" FontSize="40" 
                               HorizontalOptions="Center" VerticalOptions="Center" />
                    </Frame>
                    <Label x:Name="lblTitle" Text="Vĩnh Khánh Street" 
                           TextColor="White" FontSize="28" FontAttributes="Bold"
                           HorizontalOptions="Center" />
                    <Label x:Name="lblSubtitle" Text="Dành cho người dùng" 
                           TextColor="#94a3b8" FontSize="14"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>

                <!-- Language Selector -->
                <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="10">
                    <Button x:Name="btnLangVi" Text="VN" Grid.Column="0" Clicked="OnLanguageTapped" CommandParameter="vi" BackgroundColor="#10b981" TextColor="White" Padding="0" HeightRequest="40" CornerRadius="8"/>
                    <Button x:Name="btnLangEn" Text="EN" Grid.Column="1" Clicked="OnLanguageTapped" CommandParameter="en" BackgroundColor="#334155" TextColor="#94a3b8" Padding="0" HeightRequest="40" CornerRadius="8"/>
                    <Button x:Name="btnLangJa" Text="JA" Grid.Column="2" Clicked="OnLanguageTapped" CommandParameter="ja" BackgroundColor="#334155" TextColor="#94a3b8" Padding="0" HeightRequest="40" CornerRadius="8"/>
                    <Button x:Name="btnLangZh" Text="ZH" Grid.Column="3" Clicked="OnLanguageTapped" CommandParameter="zh-CN" BackgroundColor="#334155" TextColor="#94a3b8" Padding="0" HeightRequest="40" CornerRadius="8"/>
                </Grid>

                <!-- Form Area -->
                <VerticalStackLayout Spacing="20">
                    <VerticalStackLayout Spacing="8">
                        <Label x:Name="lblUsername" Text="Tên đăng nhập" TextColor="White" FontSize="14" Margin="5,0"/>
                        <Frame BackgroundColor="White" CornerRadius="12" Padding="15,5" HasShadow="False" BorderColor="#ffffff1a">
                            <Entry x:Name="UsernameEntry" Placeholder="Nhập tài khoản..." 
                                   TextColor="Black" PlaceholderColor="#94a3b8" />
                        </Frame>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="8">
                        <Label x:Name="lblPassword" Text="Mật khẩu" TextColor="White" FontSize="14" Margin="5,0"/>
                        <Frame BackgroundColor="White" CornerRadius="12" Padding="15,5" HasShadow="False" BorderColor="#ffffff1a">
                            <Entry x:Name="PasswordEntry" Placeholder="********" IsPassword="True"
                                   TextColor="Black" PlaceholderColor="#94a3b8" />
                        </Frame>
                    </VerticalStackLayout>

                    <!-- Login Button -->
                    <Button x:Name="btnLogin" Text="ĐĂNG NHẬP" 
                            BackgroundColor="#10b981" TextColor="White"
                            FontAttributes="Bold" HeightRequest="55" CornerRadius="12"
                            Clicked="OnLoginClicked" Margin="0,10,0,0">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="LoginButtonCommonStates">
                                <VisualState Name="LoginNormal" />
                                <VisualState Name="LoginPressed">
                                    <VisualState.Setters>
                                        <Setter Property="Scale" Value="0.95" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Button>

                    <!-- Skip Login / Guest Mode Button -->
                    <Button x:Name="btnSkipLogin" Text="Vào xem với tư cách Khách" 
                            BackgroundColor="Transparent" TextColor="#94a3b8"
                            BorderColor="#334155" BorderWidth="1"
                            FontSize="13" HeightRequest="50" CornerRadius="12"
                            Clicked="OnSkipLoginClicked" Margin="0,-10,0,0">
                    </Button>
                </VerticalStackLayout>

                <!-- Footer Links -->
                <HorizontalStackLayout HorizontalOptions="Center" Spacing="5">
                    <Label x:Name="lblNoAccount" Text="Chưa có tài khoản?" TextColor="#94a3b8" />
                    <Label x:Name="lblRegister" Text="Đăng ký ngay" TextColor="#10b981" FontAttributes="Bold">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnRegisterTapped" />
                        </Label.GestureRecognizers>
                    </Label>
                </HorizontalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>

</ContentPage>
