<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="VinhKhanhstreet.Pages.RegisterPage"
             NavigationPage.HasNavigationBar="False"
             Title="Đăng ký Chủ quán">

    <Grid>
        <!-- Background Gradient đồng nhất -->
        <BoxView>
            <BoxView.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#00B09B" Offset="0.1" />
                    <GradientStop Color="#96C93D" Offset="1.0" />
                </LinearGradientBrush>
            </BoxView.Background>
        </BoxView>

        <ScrollView>
            <VerticalStackLayout Spacing="20" Padding="20">
                
                <Label Text="ĐĂNG KÝ CHỦ QUÁN" 
                       TextColor="White" 
                       FontSize="24" 
                       FontAttributes="Bold" 
                       HorizontalOptions="Center" 
                       Margin="0,20,0,0"/>

                <!-- THÔNG TIN TÀI KHOẢN -->
                <Border StrokeShape="RoundRectangle 15" BackgroundColor="#CCFFFFFF" Padding="20" StrokeThickness="0">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Thông tin tài khoản" FontAttributes="Bold" TextColor="#2C3E50" FontSize="16"/>
                        
                        <Entry x:Name="entNewUser" Placeholder="Tên tài khoản" BackgroundColor="White"/>
                        <Entry x:Name="entNewPass" IsPassword="True" Placeholder="Mật khẩu" BackgroundColor="White"/>
                        <Entry x:Name="entConfirmPass" IsPassword="True" Placeholder="Nhập lại mật khẩu" BackgroundColor="White"/>
                    </VerticalStackLayout>
                </Border>

                <!-- THÔNG TIN QUÁN (POI) -->
                <Border StrokeShape="RoundRectangle 15" BackgroundColor="#CCFFFFFF" Padding="20" StrokeThickness="0">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Thông tin Quán ăn" FontAttributes="Bold" TextColor="#2C3E50" FontSize="16"/>
                        
                        <Entry x:Name="entResName" Placeholder="Tên quán ăn" BackgroundColor="White"/>
                        
                        <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                            <Entry x:Name="entLat" Grid.Column="0" Placeholder="Vĩ độ (Lat)" Keyboard="Numeric" BackgroundColor="White"/>
                            <Entry x:Name="entLon" Grid.Column="1" Placeholder="Kinh độ (Lon)" Keyboard="Numeric" BackgroundColor="White"/>
                        </Grid>
                        
                        <Label Text="Trạng thái quán" FontSize="14" TextColor="Gray"/>
                        <Picker x:Name="pckStatus" BackgroundColor="White" Title="Chọn trạng thái">
                            <Picker.ItemsSource>
                                <x:Array Type="{x:Type x:String}">
                                    <x:String>Đang mở cửa</x:String>
                                    <x:String>Đã đóng cửa</x:String>
                                </x:Array>
                            </Picker.ItemsSource>
                        </Picker>

                        <Label Text="Phân loại quán" FontSize="14" TextColor="Gray"/>
                        <Picker x:Name="pckCategory" BackgroundColor="White" Title="Chọn loại quán">
                            <Picker.ItemsSource>
                                <x:Array Type="{x:Type x:String}">
                                    <x:String>Quán ốc</x:String>
                                    <x:String>Tráng miệng</x:String>
                                    <x:String>Quán nướng</x:String>
                                    <x:String>Buffet</x:String>
                                    <x:String>Lẩu</x:String>
                                </x:Array>
                            </Picker.ItemsSource>
                        </Picker>

                        <Entry x:Name="entClosingTime" Placeholder="Giờ đóng cửa (VD: 23:00)" BackgroundColor="White"/>
                    </VerticalStackLayout>
                </Border>

                <!-- NỘI DUNG & DỊCH THUẬT -->
                <Border StrokeShape="RoundRectangle 15" BackgroundColor="#CCFFFFFF" Padding="20" StrokeThickness="0">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Mô tả thuyết minh (Tiếng Việt)" FontAttributes="Bold" TextColor="#2C3E50" FontSize="16"/>
                        <Editor x:Name="edDescVi" HeightRequest="100" Placeholder="Nhập mô tả tiếng Việt..." BackgroundColor="White"/>
                        
                        <Button Text="DỊCH SANG 3 NGÔN NGỮ" 
                                Clicked="OnTranslateClicked"
                                BackgroundColor="#3498DB" 
                                TextColor="White" 
                                CornerRadius="10"/>

                        <Label x:Name="lblStatusTranslate" Text="Vui lòng nhấn dịch để tạo nội dung đa ngôn ngữ" FontSize="12" TextColor="Gray" HorizontalOptions="Center"/>

                        <!-- HIỂN THỊ KẾT QUẢ DỊCH -->
                        <VerticalStackLayout x:Name="stkTranslations" IsVisible="False" Spacing="10" Margin="0,10,0,0">
                            <Label Text="English:" FontSize="12" FontAttributes="Bold" TextColor="#2980B9"/>
                            <Editor x:Name="edDescEn" FontSize="13" AutoSize="TextChanges" BackgroundColor="#F8F9FA" IsReadOnly="True"/>
                            
                            <Label Text="Japanese:" FontSize="12" FontAttributes="Bold" TextColor="#2980B9"/>
                            <Editor x:Name="edDescJa" FontSize="13" AutoSize="TextChanges" BackgroundColor="#F8F9FA" IsReadOnly="True"/>
                            
                            <Label Text="Chinese:" FontSize="12" FontAttributes="Bold" TextColor="#2980B9"/>
                            <Editor x:Name="edDescZh" FontSize="13" AutoSize="TextChanges" BackgroundColor="#F8F9FA" IsReadOnly="True"/>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- HÌNH ẢNH (MOCK 5 ẢNH) -->
                <Border StrokeShape="RoundRectangle 15" BackgroundColor="#CCFFFFFF" Padding="20" StrokeThickness="0">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Hình ảnh quán (Bắt buộc 5 tấm)" FontAttributes="Bold" TextColor="#2C3E50" FontSize="16"/>
                        <Grid ColumnDefinitions="*,*,*,*,*" ColumnSpacing="5" HeightRequest="60">
                            <Image x:Name="img1" Source="dotnet_bot.png" Aspect="AspectFill" BackgroundColor="#DCDDE1"/>
                            <Image x:Name="img2" Grid.Column="1" Aspect="AspectFill" BackgroundColor="#DCDDE1"/>
                            <Image x:Name="img3" Grid.Column="2" Aspect="AspectFill" BackgroundColor="#DCDDE1"/>
                            <Image x:Name="img4" Grid.Column="3" Aspect="AspectFill" BackgroundColor="#DCDDE1"/>
                            <Image x:Name="img5" Grid.Column="4" Aspect="AspectFill" BackgroundColor="#DCDDE1"/>
                        </Grid>
                        <Button x:Name="btnPickImages" 
                                Text="Chọn ảnh từ máy" 
                                Clicked="OnPickImagesClicked"
                                BackgroundColor="#bdc3c7" 
                                TextColor="White" 
                                CornerRadius="10"/>
                        <Label x:Name="lblPhotoCount" Text="Đã chọn: 0/5" FontSize="12" HorizontalOptions="Center" TextColor="Gray"/>
                    </VerticalStackLayout>
                </Border>

                <Button x:Name="btnGoToPayment"
                        Text="ĐI ĐẾN THANH TOÁN" 
                        Clicked="OnGoToPaymentClicked"
                        BackgroundColor="#2ECC71" 
                        TextColor="White" 
                        FontAttributes="Bold"
                        HeightRequest="55"
                        CornerRadius="27"
                        Margin="0,10,0,20">
                    <Button.Shadow>
                        <Shadow Brush="#2ECC71" Offset="0,4" Radius="10" Opacity="0.3" />
                    </Button.Shadow>
                </Button>

                <Label Text="Quay lại Đăng nhập" 
                       TextColor="White" 
                       TextDecorations="Underline"
                       HorizontalOptions="Center" 
                       Margin="0,0,0,30">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackClicked" />
                    </Label.GestureRecognizers>
                </Label>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
