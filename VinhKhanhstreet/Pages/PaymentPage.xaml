<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="VinhKhanhstreet.Pages.PaymentPage"
             NavigationPage.HasNavigationBar="False"
             Title="Thanh toán">

    <Grid>
        <BoxView>
            <BoxView.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#00B09B" Offset="0.1" />
                    <GradientStop Color="#96C93D" Offset="1.0" />
                </LinearGradientBrush>
            </BoxView.Background>
        </BoxView>

        <ScrollView>
            <VerticalStackLayout Spacing="20" Padding="25">
                
                <Label Text="XÁC NHẬN THANH TOÁN" 
                       TextColor="White" 
                       FontSize="24" 
                       FontAttributes="Bold" 
                       HorizontalOptions="Center" 
                       Margin="0,20,0,0"/>

                <Border StrokeShape="RoundRectangle 20" BackgroundColor="#CCFFFFFF" Padding="25" StrokeThickness="0">
                    <VerticalStackLayout Spacing="15">
                        <Label Text="Thông tin xác nhận" FontAttributes="Bold" FontSize="18" TextColor="#2C3E50" HorizontalOptions="Center"/>
                        
                        <BoxView HeightRequest="1" Color="#EEEEEE"/>

                        <Grid ColumnDefinitions="Auto, *" RowDefinitions="Auto, Auto, Auto" RowSpacing="10" ColumnSpacing="15">
                            <Label Text="Tài khoản:" FontAttributes="Bold" Grid.Row="0" Grid.Column="0"/>
                            <Label x:Name="lblAccount" Text="user123" Grid.Row="0" Grid.Column="1"/>

                            <Label Text="Tên quán:" FontAttributes="Bold" Grid.Row="1" Grid.Column="0"/>
                            <Label x:Name="lblResName" Text="Ốc Sài Gòn" Grid.Row="1" Grid.Column="1"/>

                            <Label Text="Số tiền:" FontAttributes="Bold" Grid.Row="2" Grid.Column="0"/>
                            <Label Text="500.000đ" TextColor="#E74C3C" FontAttributes="Bold" FontSize="18" Grid.Row="2" Grid.Column="1"/>
                        </Grid>

                        <BoxView HeightRequest="1" Color="#EEEEEE" Margin="0,10,0,0"/>

                        <Label Text="Chọn phương thức thanh toán" FontAttributes="Bold" Margin="0,10,0,0"/>
                        
                        <HorizontalStackLayout Spacing="20" HorizontalOptions="Center">
                            <Button x:Name="btnBank" Text="Ngân hàng" BackgroundColor="#34495E" TextColor="White" CornerRadius="10" WidthRequest="110" Clicked="OnMethodClicked"/>
                            <Button x:Name="btnMoMo" Text="MoMo" BackgroundColor="#A50064" TextColor="White" CornerRadius="10" WidthRequest="110" Clicked="OnMethodClicked"/>
                        </HorizontalStackLayout>

                        <!-- Khung để bạn gắn link ảnh mã QR (Hiện tại để trống) -->
                        <Frame BackgroundColor="#F9F9F9" 
                               BorderColor="#DDDDDD" 
                               HeightRequest="200" 
                               CornerRadius="15" 
                               Margin="0,10,0,0"
                               HasShadow="False">
                            <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center">
                                <Label Text="[KHUNG GẮN MÃ QR]" TextColor="#bdc3c7" FontAttributes="Bold"/>
                                <Label Text="Hình ảnh sẽ hiển thị tại đây" FontSize="12" TextColor="#bdc3c7" HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                        </Frame>

                        <Button Text="THANH TOÁN NGAY" 
                                Clicked="OnFinalPaymentClicked"
                                BackgroundColor="#2ECC71" 
                                TextColor="White" 
                                FontAttributes="Bold"
                                HeightRequest="55"
                                CornerRadius="27"
                                Margin="0,10,0,0"/>
                    </VerticalStackLayout>
                </Border>

                <Label Text="Quay lại chỉnh sửa" 
                       TextColor="White" 
                       TextDecorations="Underline"
                       HorizontalOptions="Center" 
                       Margin="0,0,0,30">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackClicked" />
                    </Label.GestureRecognizers>
                </Label>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
